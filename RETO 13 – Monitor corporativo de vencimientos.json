          "assignments": [
            {
              "id": "947905e3-5505-4f55-b61e-6fe290f325e7",
              "name": "dias_restantes",
              "value": "={{ Math.floor(DateTime.fromISO($json.fecha_vencimiento).startOf('day').diff($now.startOf('day'), 'days').days) }}",
              "type": "string"
            },
            {
              "id": "2056c38b-b76f-46bd-9f63-a9147a9049a9",
              "name": "estado_alerta",
              "value": "={{\n  Math.floor(\n    DateTime.fromISO($json.fecha_vencimiento).startOf('day')\n    .diff($now.startOf('day'), 'days').days\n  ) < 0\n    ? 'VENCIDO'\n    : Math.floor(\n        DateTime.fromISO($json.fecha_vencimiento).startOf('day')\n        .diff($now.startOf('day'), 'days').days\n      ) <= 7\n      ? 'PRÓXIMO EN 7 DÍAS'\n      : Math.floor(\n          DateTime.fromISO($json.fecha_vencimiento).startOf('day')\n          .diff($now.startOf('day'), 'days').days\n        ) <= 15\n        ? 'PRÓXIMO EN 15 DÍAS'\n        : Math.floor(\n            DateTime.fromISO($json.fecha_vencimiento).startOf('day')\n            .diff($now.startOf('day'), 'days').days\n          ) <= 30\n          ? 'PRÓXIMO EN 30 DÍAS'\n          : 'SIN ALERTA'\n}}",
              "type": "string"
            },
            {
              "id": "56bd80df-5fb0-4f6e-8ab1-070b7ef87729",
              "name": "debe_alertar",
              "value": "={{\n  $json.estado_alerta !== 'SIN ALERTA'\n  &&\n  (\n    !$json.ultima_alerta\n    ||\n    !DateTime.fromISO($json.ultima_alerta).hasSame($now, 'day')\n  )\n}}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {
          "ignoreConversionErrors": false
        }
